# 本地环境、构建与运行产物
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/_*
build/*.log
build/_audio_tmp/
dist/
*.spec
*.log
!docs/**/*.log

# 报告与临时截图（reports/standalone/<岗位>/ 下的验收产物可以提交，其余忽略）
reports/**/*.tmp
reports/**/_*.png

# 编辑器与系统垃圾
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# 根目录下的临时截图（脚本调试产物）
/build_*.png
/build_*.py


# PyInstaller 产物：仓库里只留 build/_launcher.py（spec 的入口），构建输出不入库
build/*
!build/.gitkeep
!build/_launcher.py
dist-fixed/

# Blender 自动备份文件
*.blend1

# 本地字体：微软雅黑受版权保护，不进公开仓库（缺失时游戏回退系统字体）
assets/fonts/FusionPixel12.ttf

# 打包产物副本（发布验证用，不入库）
reports/review/packaged_dist/

# 打包产物副本（发布验证用，不入库）
reports/review/packaged_build/


# 本地 QA 脚本与截图（不入库）
.tmp/
